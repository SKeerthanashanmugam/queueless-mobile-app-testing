{
  "info": {"name": "QueueLess QA API Tests", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Environment-agnostic portfolio collection. Point base_url to an authorized test API."},
  "variable": [{"key": "token", "value": ""}, {"key": "doctor_id", "value": "D001"}, {"key": "slot_id", "value": "S001"}, {"key": "appointment_id", "value": ""}],
  "item": [
    {"name": "Health", "request": {"method": "GET", "url": "{{base_url}}/health"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Response time under 3s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"]}}]},
    {"name": "Request OTP", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"mobile\":\"{{mobile}}\"}"}, "url": "{{base_url}}/auth/otp/request"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Accepted without leaking OTP', () => pm.expect([200,202]).to.include(pm.response.code));", "pm.test('Body does not expose otp', () => pm.expect(pm.response.text().toLowerCase()).not.to.include('\\\"otp\\\"'));"]}}]},
    {"name": "Search Doctors", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{base_url}}/doctors?specialty=Cardiology"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('JSON response', () => pm.response.to.be.json);"]}}]},
    {"name": "Get Slots", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{base_url}}/doctors/{{doctor_id}}/slots"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Create Appointment", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}, {"key": "Idempotency-Key", "value": "{{$guid}}"}], "body": {"mode": "raw", "raw": "{\"doctor_id\":\"{{doctor_id}}\",\"slot_id\":\"{{slot_id}}\"}"}, "url": "{{base_url}}/appointments"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Appointment created', () => pm.expect([200,201]).to.include(pm.response.code));", "if ([200,201].includes(pm.response.code)) { const j=pm.response.json(); pm.collectionVariables.set('appointment_id', j.appointment_id || j.id); }"]}}]},
    {"name": "Get Appointment", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{base_url}}/appointments/{{appointment_id}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Correct appointment returned', () => { const j=pm.response.json(); pm.expect(j.appointment_id || j.id).to.eql(pm.collectionVariables.get('appointment_id')); });"]}}]},
    {"name": "Unauthorized Prescription", "request": {"method": "GET", "url": "{{base_url}}/appointments/{{appointment_id}}/prescription"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Unauthenticated access rejected', () => pm.expect([401,403]).to.include(pm.response.code));"]}}]}
  ]
}

